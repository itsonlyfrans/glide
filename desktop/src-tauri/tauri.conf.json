{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glide",
  "version": "0.2.27",
  "identifier": "app.glide.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-src 'none'; object-src 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "category": "Utility",
    "shortDescription": "One keyboard, mouse and clipboard across your Mac and Windows computers.",
    "copyright": "Glide contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/trayTemplate.png": "trayTemplate.png",
      "icons/trayTemplate@2x.png": "trayTemplate@2x.png"
    },
    "externalBin": ["binaries/glided"],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "compression": "lzma"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwNUFBOTlFMzE1MjkzOTUKUldTVmsxSXhucWxhd01uWFVWWTFzZlNlNkVaU3QrUHROcTJBYS9NT0lnTDMyTkEvNkozWC9seDkK",
      "endpoints": [
        "https://github.com/itsonlyfrans/glide/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
